  head
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(charset='UTF-8')
    meta(name='viewport', content='user-scalable=yes, width=device-width, initial-scale=1, maximum-scale=5')
    meta(name='theme-color', content='#1976d2')
    meta(name='msapplication-TileColor', content='#1976d2')
    meta(name='msapplication-TileImage', content='/_assets/favicons/mstile-150x150.png')

    title= pageMeta.title + ' | ' + config.title

    //- SEO / OpenGraph
    meta(name='description', content=pageMeta.description)
    meta(property='og:title', content=pageMeta.title)
    meta(property='og:type', content='website')
    meta(property='og:description', content=pageMeta.description)
    meta(property='og:image', content=pageMeta.image)
    meta(property='og:url', content=pageMeta.url)
    meta(property='og:site_name', content=config.title)

    //- Favicon
    link(rel='apple-touch-icon', sizes='180x180', href='/_assets/favicons/apple-touch-icon.png')
    link(rel='icon', type='image/png', sizes='192x192', href='/_assets/favicons/android-chrome-192x192.png')
    link(rel='icon', type='image/png', sizes='32x32', href='/_assets/favicons/favicon-32x32.png')
    link(rel='icon', type='image/png', sizes='16x16', href='/_assets/favicons/favicon-16x16.png')
    link(rel='icon', type='image/png', sizes='16x16', href='/_assets/favicons/favicon-16x16.png')
    link(rel='mask-icon', href='/_assets/favicons/safari-pinned-tab.svg', color='#1976d2')
    link(rel='manifest', href='/_assets/manifest.json')

    //- Site Properties
    script.
      var siteConfig = !{JSON.stringify(siteConfig)}
      var siteLangs = !{JSON.stringify(langs)}

    //- Dev Mode Warning
    if devMode
      script.
        siteConfig.devMode = true

    //- Icon Set
    if config.theming.iconset === 'fa'
      link(
        type='text/css'
        rel='stylesheet'
        href='https://use.fontawesome.com/releases/v5.10.0/css/all.css'
        )
    else if config.theming.iconset === 'fa4'
      link(
        type='text/css'
        rel='stylesheet'
        href='https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css'
        )

    //- CSS
    
      
    link(
      type='text/css'
      rel='stylesheet'
      href='/_assets/css/app.7e4d2a2ea92425e9d187.css'
    )
      
    style(type='text/css').
      .nav-heart-btn {
        margin-right: 10px !important;
        color: #9e9e9e !important;
        position: relative !important;
        display: inline-flex !important;
        vertical-align: middle !important;
        background-color: transparent !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        width: 45px !important;
        height: 57px !important;
        min-width: 45px !important;
      }
      .nav-heart-btn::before, .nav-heart-btn::after {
        display: none !important;
      }
      .nav-heart-btn i {
        color: #9e9e9e !important;
      }
      .nav-heart-btn:hover {
        background-color: #141414 !important;
      }

    //- JS
    
      
    script(type='text/javascript' src='/_assets/js/runtime.js?1770864460')
    script(type='text/javascript' src='/_assets/js/app.js?1770864460')

    != analyticsCode.head

    block head

  body
    != analyticsCode.bodyStart
    block body
    != analyticsCode.bodyEnd

    if user && user.id !== 2
      script.
        (function() {
          var injectLikedButton = function() {
            try {
              var appBar = document.querySelector('.v-app-bar__content') || 
                           document.querySelector('.v-toolbar__content') || 
                           document.querySelector('header');
              
              if (!appBar) return;

              var btn = document.getElementById('nav-liked-pages-btn');
              if (!btn) {
                btn = document.createElement('a');
                btn.id = 'nav-liked-pages-btn';
                btn.href = '/p/liked';
                btn.className = 'v-btn v-btn--icon theme--dark v-size--default nav-heart-btn';
                btn.style.cssText = 'display: inline-flex !important; align-items: center !important; margin: 0 10px !important; color: #9e9e9e !important; border-radius: 0 !important; width: 45px !important; height: 57px !important; min-width: 45px !important;';
                btn.innerHTML = '<span class="v-btn__content"><i class="v-icon notranslate mdi mdi-heart theme--dark" style="color: #9e9e9e !important;"></i></span>';
              }

              // TIERED PLACEMENT STRATEGY
              
              // 1. Try to find Page Actions / Menu
              var targetIcon = appBar.querySelector('.mdi-dots-vertical') || 
                               appBar.querySelector('.mdi-file-document-outline') ||
                               appBar.querySelector('.mdi-square-edit-outline') ||
                               appBar.querySelector('.mdi-view-list') ||
                               appBar.querySelector('.mdi-cog');
              var target = targetIcon ? targetIcon.closest('button, a') : null;

              if (target && target.parentNode) {
                if (btn.nextSibling !== target) {
                  target.parentNode.insertBefore(btn, target);
                }
              } else {
                // 2. Fallback: After Search Bar
                var search = appBar.querySelector('.v-text-field') || appBar.querySelector('.v-input');
                if (search && search.parentNode) {
                  if (btn.previousSibling !== search) {
                    search.parentNode.insertBefore(btn, search.nextSibling);
                  }
                } else if (btn.parentNode !== appBar) {
                  // 3. Last Resort: Append to bar
                  appBar.appendChild(btn);
                }
              }
              
              // Ensure visibility
              if (btn.style.display === 'none') btn.style.display = 'inline-flex';
              
            } catch (e) {
              if (e.name !== 'NotFoundError') console.error('Liked Pages Error:', e);
            }
          };

          setInterval(injectLikedButton, 500);
          injectLikedButton();
          window.addEventListener('load', injectLikedButton);
        })();
