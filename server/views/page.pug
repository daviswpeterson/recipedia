extends master.pug

block head
  if injectCode.css
    style(type='text/css')!= injectCode.css
  if injectCode.head
    != injectCode.head
  if config.features.featurePageComments
    != comments.head
  if ratingsEnabled
    style(type='text/css').
      .page-rating {
        margin: 0 0 20px 0;
        padding: 0 0 10px 0;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
      }
      .page-rating-heart {
        display: inline-flex;
        margin-right: 15px;
      }
      .page-rating-heart i {
        cursor: pointer;
        font-size: 24px;
        color: #ccc;
        transition: color 0.2s;
      }
      .page-rating-heart i.active {
        color: #e91e63;
      }
      .page-rating-info {
        font-size: 14px;
        color: #666;
      }

block body
  #root
    page(
      locale=page.localeCode
      path=page.path
      title=page.title
      description=page.description
      :tags=page.tags
      created-at=page.createdAt
      updated-at=page.updatedAt
      author-name=page.authorName
      :author-id=page.authorId
      editor=page.editorKey
      :is-published=page.isPublished.toString()
      toc=Buffer.from(page.toc).toString('base64')
      :page-id=page.id
      sidebar=Buffer.from(JSON.stringify(sidebar)).toString('base64')
      nav-mode=config.nav.mode
      comments-enabled=config.features.featurePageComments
      effective-permissions=Buffer.from(JSON.stringify(effectivePermissions)).toString('base64')
      comments-external=comments.codeTemplate
      edit-shortcuts=Buffer.from(JSON.stringify(config.editShortcuts)).toString('base64')
      filename=pageFilename
      )
      template(slot='contents')
        if ratingsEnabled
          .page-rating
            .page-rating-heart#page-rating-heart
              i(class=(userRating >= 1 ? 'mdi mdi-heart active' : 'mdi mdi-heart-outline'), data-rating=(userRating >= 1 ? 0 : 1))
            .page-rating-info
              span#page-rating-count= ratingCount
              |  likes
        div!= page.render
      template(slot='comments')
        div!= comments.main
  if injectCode.body
    != injectCode.body
  if config.features.featurePageComments
    != comments.body
  
  if ratingsEnabled
    script.
      (function() {
        var pageId = !{page.id};
        
        document.body.addEventListener('click', function(e) {
          if (e.target.matches('#page-rating-heart i')) {
            var rating = parseInt(e.target.getAttribute('data-rating'));
            
            fetch('/graphql', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              body: JSON.stringify({
                query: 'mutation($pageId: Int!, $rating: Int!) { ratings { save(pageId: $pageId, rating: $rating) { responseResult { message }, ratingScore, ratingCount, userRating } } }',
                variables: {
                  pageId: parseInt(pageId),
                  rating: parseInt(rating)
                }
              })
            })
            .then(r => r.json())
            .then(data => {
              if (data.data && data.data.ratings && data.data.ratings.save) {
                var result = data.data.ratings.save;
                var countEl = document.getElementById('page-rating-count');
                if (countEl) countEl.innerText = result.ratingCount;
                
                var heartContainer = document.getElementById('page-rating-heart');
                if (heartContainer) {
                  var heartIcon = heartContainer.querySelector('i');
                  if (result.userRating >= 1) {
                    heartIcon.className = 'mdi mdi-heart active';
                    heartIcon.setAttribute('data-rating', 0);
                  } else {
                    heartIcon.className = 'mdi mdi-heart-outline';
                    heartIcon.setAttribute('data-rating', 1);
                  }
                }
              } else if (data.errors) {
                alert(data.errors[0].message);
              }
            });
          }
        });
      })();
